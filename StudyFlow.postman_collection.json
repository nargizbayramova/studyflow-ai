{
  "info": {
    "_postman_id": "a2e8c9d0-1b2c-4f88-9a01-studyflow0001",
    "name": "StudyFlow API v1 (Assignment 2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CRUD, RBAC (User A, User B, Admin), validation error, and HTML greeting examples."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api/v1" },
    { "key": "tokenA", "value": "" },
    { "key": "tokenB", "value": "" },
    { "key": "tokenAdmin", "value": "" },
    { "key": "courseIdA", "value": "1" },
    { "key": "taskIdA", "value": "1" }
  ],
  "item": [
    {
      "name": "0. Greeting & Health",
      "item": [
        {
          "name": "HTML Greeting Page",
          "request": { "method": "GET", "url": "{{baseUrl}}/greeting" }
        },
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "1. Auth (Seeded Accounts)",
      "item": [
        {
          "name": "Login User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access_token) pm.collectionVariables.set('tokenA', j.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "usera@studyflow.edu" },
                { "key": "password", "value": "password123" }
              ]
            }
          }
        },
        {
          "name": "Login User B",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access_token) pm.collectionVariables.set('tokenB', j.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "userb@studyflow.edu" },
                { "key": "password", "value": "password123" }
              ]
            }
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access_token) pm.collectionVariables.set('tokenAdmin', j.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "admin@studyflow.edu" },
                { "key": "password", "value": "password123" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Tasks CRUD (User A)",
      "item": [
        {
          "name": "List Tasks (User A)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": "{{baseUrl}}/tasks?page=1&perPage=10"
          }
        },
        {
          "name": "Create Task (User A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data && j.data.id) pm.collectionVariables.set('taskIdA', String(j.data.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenA}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": {{courseIdA}},\n  \"title\": \"Prepare API Demo\",\n  \"due_date\": \"2026-11-20T23:59:00Z\",\n  \"estimated_hours\": 3.0,\n  \"weight_percent\": 15.0,\n  \"priority\": \"high\"\n}"
            }
          }
        },
        {
          "name": "Get Task by ID (User A)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": "{{baseUrl}}/tasks/{{taskIdA}}"
          }
        },
        {
          "name": "Update Task via PUT (User A)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenA}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskIdA}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": {{courseIdA}},\n  \"title\": \"Prepare Updated API Demo\",\n  \"due_date\": \"2026-11-21T23:59:00Z\",\n  \"estimated_hours\": 4.0,\n  \"weight_percent\": 20.0,\n  \"status\": \"in_progress\",\n  \"priority\": \"high\"\n}"
            }
          }
        },
        {
          "name": "Delete Task (User A)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": "{{baseUrl}}/tasks/{{taskIdA}}"
          }
        }
      ]
    },
    {
      "name": "3. Authorization & Validation Errors",
      "item": [
        {
          "name": "401 Missing Token",
          "request": { "method": "GET", "url": "{{baseUrl}}/tasks" }
        },
        {
          "name": "401 Invalid Token",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer invalid-token" }],
            "url": "{{baseUrl}}/tasks"
          }
        },
        {
          "name": "403 User B Reads User A Task",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }],
            "url": "{{baseUrl}}/tasks/{{taskIdA}}"
          }
        },
        {
          "name": "200 Admin Reads User A Task",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
            "url": "{{baseUrl}}/tasks/{{taskIdA}}"
          }
        },
        {
          "name": "404 Non-Existent Task ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": "{{baseUrl}}/tasks/999999"
          }
        },
        {
          "name": "400 Validation Error (Short Title + Unknown Field)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenA}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": {{courseIdA}},\n  \"title\": \"Hi\",\n  \"due_date\": \"2026-11-20T23:59:00Z\",\n  \"extra_unknown\": true\n}"
            }
          }
        }
      ]
    }
  ]
}
